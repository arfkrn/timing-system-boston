<Window x:Class="boston_timing_system.Views.MeetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:boston_timing_system.Helpers"
        xmlns:models="clr-namespace:boston_timing_system.Models"
        mc:Ignorable="d"
        Title="Swimming Meet &amp; Data Manager" 
        Height="700" Width="1080"
        MinHeight="580" MinWidth="900"
        Background="#FFFFFF"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <helpers:StatusToBrushConverter x:Key="StatusToBrushConverter" />

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionMiniButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelOutlinedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F8FAFC" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#0F172A" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClearLaneButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#DC2626" />
            <Setter Property="Background" Value="#FEE2E2" />
            <Setter Property="BorderBrush" Value="#FCA5A5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FCA5A5" />
                                <Setter Property="Foreground" Value="#7F1D1D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F87171" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Toggle arrow style for TreeView items with hand cursor -->
        <Style x:Key="ExpandCollapseToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="Transparent" Width="16" Height="16" Cursor="Hand">
                            <Path x:Name="ExpandPath"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center" 
                                  Data="M 0 0 L 4 4 L 8 0 Z" 
                                  Fill="#64748B"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Data" TargetName="ExpandPath" Value="M 0 0 L 4 4 L 0 8 Z"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Fill" TargetName="ExpandPath" Value="#0284C7"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                <Setter Property="Fill" TargetName="ExpandPath" Value="#FFFFFF"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- 1. Header & Actions Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- 2. Meet Metadata Inputs -->
            <RowDefinition Height="Auto" />
            <!-- 3. Main Data Content (Events/Heats list + Lane Athlete Grid) -->
            <RowDefinition Height="*" />
            <!-- 4. Footer & Action Buttons -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER & ACTIONS TOOLBAR -->
        <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="6" Padding="16,12" Margin="0,0,0,12"
                BorderBrush="#CBD5E1" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="txtMeetHeaderSubtitle" Text="Event Management, Heat Schedule, &amp; Results Export" 
                               FontSize="17" FontWeight="Bold" Foreground="#0F172A" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Excel Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnDownloadTemplate" Content="Download Template" 
                            Style="{StaticResource HeaderButtonStyle}" 
                            Background="#475569" Margin="0,0,8,0" 
                            Click="BtnDownloadTemplate_Click"/>
                    <Button x:Name="btnImportExcel" Content="Import Event" 
                            Style="{StaticResource HeaderButtonStyle}" 
                            Background="#0D9488" Margin="0,0,8,0" 
                            Click="BtnImportExcel_Click"/>
                    <Button x:Name="btnExportResults" Content="Export Results" 
                            Style="{StaticResource HeaderButtonStyle}" 
                            Background="#D97706" 
                            Click="BtnExportResults_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. MEET METADATA INPUTS -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="6" Padding="14,10" Margin="0,0,0,12" 
                BorderBrush="#CBD5E1" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="COMPETITION NAME" FontSize="10.5" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,3"/>
                <TextBox x:Name="txtMeetName" FontSize="13" FontWeight="SemiBold" 
                         Foreground="#0F172A" Background="#F8FAFC" BorderBrush="#CBD5E1" Padding="8,5" />
            </StackPanel>
        </Border>

        <!-- 3. MAIN DATA CONTENT -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Left: Events & Heats Navigation & Tools -->
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="12" />
                <!-- Right: Event Editor & Athletes in Selected Heat -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: EVENTS & HEATS LIST -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="6" Padding="12" BorderBrush="#CBD5E1" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="LIST OF EVENT &amp; HEAT NUMBERS" 
                               FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,8"/>

                    <!-- Action buttons: + Event, + Heat, Delete -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnAddEvent" Content="New Event" Grid.Column="0"
                                Style="{StaticResource ActionMiniButtonStyle}" Background="#0284C7" Margin="0,0,4,0"
                                ToolTip="Tambah Event Baru" Click="BtnAddEvent_Click"/>
                        <Button x:Name="btnAddHeat" Content="New Heat" Grid.Column="1"
                                Style="{StaticResource ActionMiniButtonStyle}" Background="#0D9488" Margin="2,0,4,0"
                                ToolTip="Tambah Heat pada Event yang dipilih" Click="BtnAddHeat_Click"/>
                        <Button x:Name="btnDeleteSelected" Content="Delete" Grid.Column="2"
                                Style="{StaticResource ActionMiniButtonStyle}" Background="#E11D48" Padding="10,5"
                                ToolTip="Hapus Event atau Heat terpilih" Click="BtnDeleteSelected_Click"/>
                    </Grid>

                    <TreeView x:Name="tvEvents" Grid.Row="2" Background="#FFFFFF" BorderThickness="0"
                              SelectedItemChanged="TvEvents_SelectedItemChanged">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="True" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Padding" Value="4,3" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Border x:Name="Bd"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="{TemplateBinding Padding}"
                                                        Margin="0,1"
                                                        Cursor="Hand">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton x:Name="Expander" 
                                                                      Style="{StaticResource ExpandCollapseToggleStyle}" 
                                                                      IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" 
                                                                      ClickMode="Press"
                                                                      Cursor="Hand"/>
                                                        <ContentPresenter x:Name="PART_Header" 
                                                                          Grid.Column="1" 
                                                                          ContentSource="Header" 
                                                                          HorizontalAlignment="Stretch" 
                                                                          VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>
                                                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="18,0,0,0"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <MultiTrigger>
                                                    <MultiTrigger.Conditions>
                                                        <Condition Property="IsMouseOver" SourceName="Bd" Value="True"/>
                                                        <Condition Property="IsSelected" Value="False"/>
                                                    </MultiTrigger.Conditions>
                                                    <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0"/>
                                                </MultiTrigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#0284C7"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#0369A1"/>
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type models:RaceEventModel}" ItemsSource="{Binding Heats}">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#0284C7" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                                <HierarchicalDataTemplate.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:HeatModel}">
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="12.5">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#0F172A" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text=" (Completed)" FontWeight="Bold" FontSize="11" Margin="4,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#16A34A" />
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=TreeViewItem}}" Value="True">
                                                                <Setter Property="Foreground" Value="#DCFCE7" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </HierarchicalDataTemplate.ItemTemplate>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <!-- RIGHT: EVENT EDITOR & ATHLETES IN SELECTED HEAT (10 LANES) -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="6" Padding="14" BorderBrush="#CBD5E1" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 1. Event Properties (No Event & Nama Event) -->
                        <RowDefinition Height="Auto" />
                        <!-- 2. Heat Header & Actions -->
                        <RowDefinition Height="Auto" />
                        <!-- 3. DataGrid 10 Lanes -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 1. Event Properties Form -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="NO. EVENT" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtEventNumber" Grid.Row="1" Grid.Column="0" FontSize="13" FontWeight="Bold"
                                     HorizontalContentAlignment="Center" Background="#FFFFFF" BorderBrush="#CBD5E1" Padding="6,4"
                                     TextChanged="TxtEventNumber_TextChanged"/>

                            <TextBlock Grid.Row="0" Grid.Column="2" Text="EVENT NAME" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtEventName" Grid.Row="1" Grid.Column="2" FontSize="13" FontWeight="SemiBold"
                                     Background="#FFFFFF" BorderBrush="#CBD5E1" Padding="8,4"
                                     TextChanged="TxtEventName_TextChanged"/>
                        </Grid>
                    </Border>

                    <!-- 2. Heat Header & Actions -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtSelectedHeatTitle" Text="Select Event and Heat" 
                                       FontSize="14" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock x:Name="txtSelectedHeatSubtitle" Text="List of athletes on the track 1 - 9, 0" 
                                       FontSize="12" Foreground="#475569" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="btnAddNewOwsSwimmer" Content="Add New Athlete"
                                    Style="{StaticResource ActionMiniButtonStyle}" Background="#0284C7"
                                    Padding="10,5" Margin="0,0,8,0" Visibility="Collapsed"
                                    Click="BtnAddNewOwsSwimmer_Click" ToolTip="Add a new athlete to this heat"/>
                            <Button x:Name="btnClearHeat" Content="Empty Heat"
                                    Style="{StaticResource CancelOutlinedButtonStyle}" Padding="10,5" FontSize="11.5"
                                    Click="BtnClearHeat_Click" ToolTip="Clear all athletes from this heat"/>
                        </StackPanel>
                    </Grid>

                    <!-- 3. DataGrid of Lanes (Lanes 1 - 10) -->
                    <DataGrid x:Name="dgHeatLanes" Grid.Row="2" AutoGenerateColumns="False" 
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              Background="#FFFFFF" RowBackground="#FFFFFF" AlternatingRowBackground="#F8FAFC"
                              Foreground="#0F172A" BorderBrush="#CBD5E1" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                              ColumnHeaderHeight="32" RowHeight="34"
                              CellEditEnding="DgHeatLanes_CellEditEnding"
                              FontSize="12.5" SelectionChanged="dgHeatLanes_SelectionChanged">
                        <DataGrid.Resources>
                            <!-- Override system highlight brushes so row and cell selections use soft sky-blue with high-contrast dark text -->
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E0F2FE"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E0F2FE"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                        </DataGrid.Resources>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Background" Value="#FFFFFF" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#E2E8F0" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F1F5F9" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E0F2FE" />
                                        <Setter Property="BorderBrush" Value="#BAE6FD" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#0F172A" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}" 
                                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                                    Padding="{TemplateBinding Padding}" 
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#BAE6FD" />
                                        <Setter Property="Foreground" Value="#0F172A" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#EDF2F7" />
                                <Setter Property="Foreground" Value="#0F172A" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="FontSize" Value="11.5" />
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="BorderBrush" Value="#CBD5E1" />
                                <Setter Property="BorderThickness" Value="0,0,1,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <!-- Lane / BIB Number -->
                            <DataGridTextColumn x:Name="colLaneOrBib" Header="LN" Binding="{Binding BibNumber, UpdateSourceTrigger=PropertyChanged}" Width="56" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="4,2"/>
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="BorderBrush" Value="#0284C7"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- Athlete Name -->
                            <DataGridTextColumn Header="ATHLETE" Binding="{Binding SwimmerName, UpdateSourceTrigger=PropertyChanged}" Width="*" MinWidth="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="Margin" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="6,2"/>
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="BorderBrush" Value="#0284C7"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- Club -->
                            <DataGridTextColumn Header="CLUB" Binding="{Binding Club, UpdateSourceTrigger=PropertyChanged}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Foreground" Value="#334155"/>
                                        <Setter Property="Margin" Value="6,0"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="Padding" Value="6,2"/>
                                        <Setter Property="Background" Value="#FFFFFF"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                        <Setter Property="BorderBrush" Value="#0284C7"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>

                            <!-- Status Dropdown with Colored Badge -->
                            <DataGridTemplateColumn Header="STATUS" Width="105">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border x:Name="bdStatusTag" CornerRadius="4" Padding="6,2" HorizontalAlignment="Center" VerticalAlignment="Center" Cursor="Hand">
                                            <TextBlock x:Name="tbStatus" Text="{Binding Status}" 
                                                       FontWeight="Bold" 
                                                       FontSize="11.5"
                                                       Cursor="Hand"
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Ready">
                                                <Setter TargetName="bdStatusTag" Property="Background" Value="#E0F2FE"/>
                                                <Setter TargetName="tbStatus" Property="Foreground" Value="#0369A1"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="OFF">
                                                <Setter TargetName="bdStatusTag" Property="Background" Value="#F1F5F9"/>
                                                <Setter TargetName="tbStatus" Property="Foreground" Value="#64748B"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="DQ">
                                                <Setter TargetName="bdStatusTag" Property="Background" Value="#FEE2E2"/>
                                                <Setter TargetName="tbStatus" Property="Foreground" Value="#DC2626"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="DNS">
                                                <Setter TargetName="bdStatusTag" Property="Background" Value="#FEF3C7"/>
                                                <Setter TargetName="tbStatus" Property="Foreground" Value="#D97706"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="DNF">
                                                <Setter TargetName="bdStatusTag" Property="Background" Value="#FFE4E6"/>
                                                <Setter TargetName="tbStatus" Property="Foreground" Value="#E11D48"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Finished">
                                                <Setter TargetName="bdStatusTag" Property="Background" Value="#DCFCE7"/>
                                                <Setter TargetName="tbStatus" Property="Foreground" Value="#15803D"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <ComboBox SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                                  Cursor="Hand"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                            <models:LaneStatus>Ready</models:LaneStatus>
                                            <models:LaneStatus>OFF</models:LaneStatus>
                                            <models:LaneStatus>DNS</models:LaneStatus>
                                            <models:LaneStatus>DQ</models:LaneStatus>
                                            <models:LaneStatus>DNF</models:LaneStatus>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>

                            <!-- Finish Time -->
                            <DataGridTextColumn Header="TIME" Binding="{Binding FormattedTime}" Width="85" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontFamily" Value="Consolas, Segoe UI"/>
                                        <Setter Property="Foreground" Value="#475569"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Rank -->
                            <DataGridTextColumn Header="RK" Binding="{Binding RankDisplay}" Width="45" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Action: Clear Lane -->
                            <DataGridTemplateColumn Header="ACTION" Width="65">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Clear" Style="{StaticResource ClearLaneButtonStyle}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Click="BtnClearLane_Click" ToolTip="Kosongkan lintasan ini"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. FOOTER & ACTION BUTTONS -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource CancelOutlinedButtonStyle}" 
                            Margin="0,0,8,0" Click="BtnCancel_Click"/>
                    <Button Content="Apply &amp; Load" Style="{StaticResource HeaderButtonStyle}" Background="#16A34A" 
                            Click="BtnApply_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
