<Window x:Class="boston_timing_system.Views.ExportSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ekspor Hasil Balapan ke Excel" 
        Height="540" Width="520"
        MinHeight="460" MinWidth="440"
        Background="#F8FAFC"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Content -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="EKSPOR HASIL KE FILE EXCEL" 
                           FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                <TextBlock Text="Pilih nomor lomba yang ingin diekspor. File Excel otomatis memuat seluruh heat per event." 
                           FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- MAIN EVENT CHECKLIST BOX -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Quick action bar: Pilih Semua & Batal Pilih -->
                    <RowDefinition Height="Auto"/>
                    <!-- Event checklist listbox -->
                    <RowDefinition Height="*"/>
                    <!-- Information Notice -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Selection Quick Buttons -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Daftar Nomor Lomba (Events):" FontSize="12" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnSelectAll" Content="Pilih Semua" FontSize="11.5" FontWeight="SemiBold" Padding="10,4" Background="#F1F5F9" 
                                Foreground="#0284C7" BorderBrush="#BAE6FD" BorderThickness="1" Cursor="Hand" Margin="0,0,6,0"
                                Click="BtnSelectAll_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="btnDeselectAll" Content="Batal Pilih" FontSize="11.5" FontWeight="SemiBold" Padding="10,4" Background="#F1F5F9" 
                                Foreground="#475569" BorderBrush="#CBD5E1" BorderThickness="1" Cursor="Hand"
                                Click="BtnDeselectAll_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 2. List of Events with Checkboxes -->
                <ListBox x:Name="lbEvents" Grid.Row="1" BorderThickness="1" BorderBrush="#E2E8F0" Background="#F8FAFC" 
                         ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="4">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#EDF2F7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" Margin="4,2" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A"/>
                                    <TextBlock Text="{Binding ResultCountText}" FontSize="11.5" Foreground="{Binding ResultStatusBrush}" Margin="8,0,0,0"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty State when no events have recorded results -->
                <Border x:Name="pnlEmptyState" Grid.Row="1" Background="#F8FAFC" BorderThickness="1" BorderBrush="#E2E8F0" 
                        CornerRadius="6" Padding="20" Visibility="Collapsed" VerticalAlignment="Stretch">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="📋" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Belum Ada Hasil Balapan" FontSize="13.5" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                        <TextBlock Text="Tidak ada nomor lomba yang memiliki hasil balapan tercatat. Lomba yang belum berjalan tidak akan ditampilkan di daftar ekspor." 
                                   FontSize="11.5" Foreground="#64748B" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 3. Notice -->
                <Border Grid.Row="2" Background="#F0F9FF" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="6" 
                        Padding="10,8" Margin="0,10,0,0">
                    <TextBlock Text="💡 Hanya nomor lomba yang memiliki catatan hasil yang ditampilkan. Setiap nomor yang dipilih otomatis mengekspor seluruh heat terkait." 
                               FontSize="11.5" Foreground="#0369A1" TextWrapping="Wrap"/>
                </Border>
            </Grid>
        </Border>

        <!-- FOOTER BUTTONS -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Batal" Style="{StaticResource CancelButtonStyle}" 
                            Margin="0,0,10,0" Click="BtnCancel_Click"/>
                    <Button x:Name="btnExportNow" Content="SIMPAN KE EXCEL" 
                            Style="{StaticResource HeaderButtonStyle}" 
                            Background="#16A34A" 
                            Click="BtnExportNow_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
