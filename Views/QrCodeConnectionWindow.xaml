<Window x:Class="boston_timing_system.Views.QrCodeConnectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Scan QR Code - Koneksi Mobile Wasit &amp; Starter" 
        Height="650" Width="490"
        MinHeight="580" MinWidth="440"
        Background="#F8FAFC"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content with QR & Info -->
            <RowDefinition Height="*"/>
            <!-- Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="SCAN QR CODE - MOBILE CONNECT" 
                               FontSize="14.5" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Scan dengan HP untuk menghubungkan Wasit, Starter, atau Chief" 
                               FontSize="11.5" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- QR Image Frame -->
                    <RowDefinition Height="*"/>
                    <!-- Info Summary Box -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- QR CODE IMAGE DISPLAY (ENLARGED) -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" 
                        CornerRadius="8" Padding="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,14">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                    </Border.Effect>
                    <Image x:Name="imgQrCode" Width="280" Height="280" 
                           RenderOptions.BitmapScalingMode="NearestNeighbor" 
                           SnapsToDevicePixels="True"/>
                </Border>

                <!-- CONNECTION INFO SUMMARY -->
                <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="95"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- IP Server -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="IP Server:" FontSize="11" Foreground="#64748B" Margin="0,1"/>
                        <TextBlock x:Name="txtInfoIp" Grid.Row="0" Grid.Column="1" Text="192.168.1.4" FontSize="11" FontWeight="Bold" Foreground="#0F172A" Margin="0,1"/>

                        <!-- Access Code -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Access Code:" FontSize="11" Foreground="#64748B" Margin="0,1"/>
                        <TextBlock x:Name="txtInfoCode" Grid.Row="1" Grid.Column="1" Text="----" FontSize="11" FontWeight="Bold" Foreground="#16A34A" Margin="0,1"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- FOOTER BAR -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10">
            <Grid>
                <Button Content="TUTUP" 
                        Style="{StaticResource ActionButtonStyle}" 
                        Width="100" HorizontalAlignment="Right"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
