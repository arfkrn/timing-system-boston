<Window x:Class="boston_timing_system.Views.ThermalPrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Print Out Race Results" 
        Height="760" Width="740"
        MinHeight="620" MinWidth="680"
        Background="#F8FAFC"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="PrintPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#16A34A" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15803D" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#166534" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#94A3B8" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryOutlinedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Main 2-Column Content -->
            <RowDefinition Height="*"/>
            <!-- Footer Buttons -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CETAK STRUK HASIL BALAPAN" 
                               FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock Text="Cetak struk resmi hasil balapan saat ini ke printer" 
                               FontSize="12" Foreground="#64748B" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="5" Padding="10,5" VerticalAlignment="Center">
                    <TextBlock Text="FORMAT: 58MM POS ROLL" FontSize="11" FontWeight="Bold" Foreground="#166534"/>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT (2 COLUMNS) -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <!-- Left: 58mm Receipt Preview -->
                <ColumnDefinition Width="280"/>
                <!-- Right: Printer Controls & Info -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT: RECEIPT PREVIEW (Realistic 58mm thermal slip) -->
            <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PRATINJAU STRUK (58MM)" 
                               FontSize="11" FontWeight="Bold" Foreground="#475569" 
                               Margin="0,0,0,8" HorizontalAlignment="Center"/>

                    <!-- Scrollable realistic slip paper -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Border Background="#FFFFFF" BorderBrush="#94A3B8" BorderThickness="1" 
                                CornerRadius="2" Width="216" HorizontalAlignment="Center" Margin="0,4,0,10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.12"/>
                            </Border.Effect>

                            <StackPanel>
                                <!-- Simulated Perforated / Cut Edge Top -->
                                <Border BorderBrush="#94A3B8" BorderThickness="0,0,0,1" Margin="4,0" Height="2"/>

                                <!-- Receipt Visual Content Host -->
                                <Border x:Name="bdReceiptContainer" Margin="4,6,4,6" HorizontalAlignment="Center"/>

                                <!-- Simulated Perforated / Cut Edge Bottom -->
                                <Border BorderBrush="#94A3B8" BorderThickness="0,1,0,0" Margin="4,0" Height="2"/>
                            </StackPanel>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- RIGHT: CONTROLS & PRINT SETUP -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="18" Margin="4,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Section Title -->
                    <TextBlock Grid.Row="0" Text="Pengaturan Pencetakan" 
                               FontSize="14" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                    <!-- Printer Selection -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,14">
                        <TextBlock Text="Pilih Printer Thermal 58mm:" 
                                   FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,6"/>
                        <ComboBox x:Name="cmbPrinters" Height="38" FontSize="13" 
                                  Padding="8,6" Background="#FFFFFF" BorderBrush="#CBD5E1" 
                                  SelectionChanged="CmbPrinters_SelectionChanged"/>
                        
                        <TextBlock x:Name="txtPrinterStatus" Text="Mendeteksi printer..." 
                                   FontSize="11" Foreground="#16A34A" FontWeight="Medium" Margin="0,6,0,0"/>
                    </StackPanel>

                    <!-- Race Info Summary Box -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Informasi Hasil Yang Dicetak" FontSize="11.5" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Kompetisi:" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock x:Name="txtInfoMeet" Grid.Column="1" Text="Swimming Competition" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Event &amp; Heat:" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock x:Name="txtInfoEventHeat" Grid.Column="1" Text="Event #1 - Heat #1" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Lebar Kertas:" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="58 mm (Roll Thermal Standar)" FontSize="11.5" FontWeight="SemiBold" Foreground="#0F172A"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,12">
                        <!-- Status Notification -->
                        <Border x:Name="bdFeedback" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" 
                                CornerRadius="5" Padding="10,8" Visibility="Collapsed">
                            <TextBlock x:Name="txtFeedback" Text="Struk berhasil dicetak!" 
                                       FontSize="12" FontWeight="SemiBold" Foreground="#166534" 
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- FOOTER BAR -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10">
            <Grid>
                <TextBlock Text="Boston Timing System • 58mm Thermal Printing Module" 
                           FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center"/>
                <Button x:Name="btnPrintNow" 
                        Content="PRINT" 
                        Width="100"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PrintPrimaryButtonStyle}" 
                        Click="BtnPrintNow_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
